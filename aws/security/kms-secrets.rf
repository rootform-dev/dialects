rule "kms-key" {
  match {
    kind = "resource"
    type = "aws_kms_key"
  }

  as = concept.core.encryption-key
}

rule "kms-alias" {
  match {
    kind = "resource"
    type = "aws_kms_alias"
  }

  as = concept.key-alias

  contribution {
    to  = concept.core.encryption-key
    via = source.target_key_id
  }
}

rule "secretsmanager-secret" {
  match {
    kind = "resource"
    type = "aws_secretsmanager_secret"
  }

  as = concept.core.managed-secret
}
