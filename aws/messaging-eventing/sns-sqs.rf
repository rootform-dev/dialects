rule "sns-topic" {
  match {
    type = "aws_sns_topic"
  }

  as = concept.core.message-topic
}

rule "sns-topic-subscription" {
  match {
    type = "aws_sns_topic_subscription"
  }

  as = concept.core.message-subscription

  relation "subscribes-to" {
    to  = concept.core.message-topic
    via = source.topic_arn
  }
}

rule "sqs-queue" {
  match {
    type = "aws_sqs_queue"
  }

  as = concept.core.message-queue
}
