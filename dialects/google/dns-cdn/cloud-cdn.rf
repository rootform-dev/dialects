concept "cloud-cdn-service" {
  kind        = entity
  description = "A Cloud CDN or Media CDN edge delivery service."
}

concept "cloud-cdn-origin" {
  kind        = detail
  description = "An origin contributing content to a Media CDN edge cache service."
}

rule "cloud-cdn-backend-bucket" {
  match {
    kind  = "resource"
    type  = "google_compute_backend_bucket"
    where = source.enable_cdn == true
  }

  as = concept.cloud-cdn-service
}

rule "media-cdn-service" {
  match {
    kind = "resource"
    type = "google_network_services_edge_cache_service"
  }

  as = concept.cloud-cdn-service
}

rule "media-cdn-origin" {
  match {
    kind = "resource"
    type = "google_network_services_edge_cache_origin"
  }

  as = concept.cloud-cdn-origin
}
