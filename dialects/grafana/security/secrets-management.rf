concept "secret-keeper" {
  kind        = entity
  description = "A Grafana keeper backed by managed secret storage."
}

rule "apps-secret-keeper-v1beta1" {
  match {
    kind = "resource"
    type = "grafana_apps_secret_keeper_v1beta1"
  }

  as = concept.secret-keeper

  relation "authorized-by" {
    to  = concept.core.service-identity
    via = source.spec[0].aws[0].assume_role[0].assume_role_arn
  }
}

rule "apps-secret-securevalue-v1beta1" {
  match {
    kind = "resource"
    type = "grafana_apps_secret_securevalue_v1beta1"
  }

  as = concept.core.managed-secret
}
