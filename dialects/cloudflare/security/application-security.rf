concept "edge-security-configuration" {
  kind        = detail
  description = "WAF, API, bot, content, credential, or certificate protection applied at the Cloudflare edge."
}

concept "turnstile-widget" {
  kind        = entity
  description = "A Cloudflare Turnstile site widget protecting an application interaction."
}

concept "vulnerability-scanner-target" {
  kind        = entity
  description = "A target environment scanned by Cloudflare for vulnerabilities."
}

rule "ruleset" {
  match {
    kind = "resource"
    type = "cloudflare_ruleset"
  }

  as = concept.edge-security-configuration

  contribution {
    to  = concept.core.dns-zone
    via = source.zone_id
  }
}

rule "firewall-rule" {
  match {
    kind = "resource"
    type = "cloudflare_firewall_rule"
  }

  as = concept.edge-security-configuration

  contribution {
    to  = concept.core.dns-zone
    via = source.zone_id
  }
}

