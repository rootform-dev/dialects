rule "pinpoint-adm-channel" {
  match {
    kind = "resource"
    type = "aws_pinpoint_adm_channel"
  }

  as = concept.pinpoint-component

  contribution {
    to  = concept.pinpoint-app
    via = source.application_id
  }
}

