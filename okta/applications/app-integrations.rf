rule "api-service-integration" {
  match {
    kind = "resource"
    type = "okta_api_service_integration"
  }

  as = concept.core.identity-application
}

rule "api-service-integration-lookup" {
  match {
    kind = "data"
    type = "okta_api_service_integration"
  }

  as = concept.core.identity-application
}

rule "app-auto-login" {
  match {
    kind = "resource"
    type = "okta_app_auto_login"
  }

  as = concept.core.identity-application
}

rule "app-basic-auth" {
  match {
    kind = "resource"
    type = "okta_app_basic_auth"
  }

  as = concept.core.identity-application
}

rule "app-bookmark" {
  match {
    kind = "resource"
    type = "okta_app_bookmark"
  }

  as = concept.core.identity-application
}

rule "app-lookup" {
  match {
    kind = "data"
    type = "okta_app"
  }

  as = concept.core.identity-application
}

rule "app-oauth" {
  match {
    kind = "resource"
    type = "okta_app_oauth"
  }

  as = concept.core.identity-application
}

rule "app-oauth-lookup" {
  match {
    kind = "data"
    type = "okta_app_oauth"
  }

  as = concept.core.identity-application
}

rule "app-saml" {
  match {
    kind = "resource"
    type = "okta_app_saml"
  }

  as = concept.core.identity-application

  relation "uses-inline-hook" {
    to  = concept.identity-event-extension
    via = source.inline_hook_id
  }
}

rule "app-saml-lookup" {
  match {
    kind = "data"
    type = "okta_app_saml"
  }

  as = concept.core.identity-application
}

rule "app-secure-password-store" {
  match {
    kind = "resource"
    type = "okta_app_secure_password_store"
  }

  as = concept.core.identity-application
}

rule "app-shared-credentials" {
  match {
    kind = "resource"
    type = "okta_app_shared_credentials"
  }

  as = concept.core.identity-application
}

rule "app-swa" {
  match {
    kind = "resource"
    type = "okta_app_swa"
  }

  as = concept.core.identity-application
}

rule "app-three-field" {
  match {
    kind = "resource"
    type = "okta_app_three_field"
  }

  as = concept.core.identity-application
}
