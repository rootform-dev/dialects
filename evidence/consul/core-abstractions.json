      }
    },
    {
      "candidate": "cluster-peering",
      "disposition": "reject-virtual-network-peering",
      "reason": "Consul peering exchanges service discovery and mesh traffic between control planes, not routes between virtual networks",
      "sources": {
        "consul": "https://developer.hashicorp.com/consul/docs/east-west/cluster-peering",
        "aws": "https://docs.aws.amazon.com/vpc/latest/peering/what-is-vpc-peering.html",
