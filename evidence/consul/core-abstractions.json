      "candidate": "service-mesh",
      "disposition": "defer-root-parity",
      "reason": "Consul and Google expose mesh roots, but AWS root is currently unrepresented and Azure has no equivalent independent provider surface",
      "sources": {
        "consul": "https://developer.hashicorp.com/consul/docs/use-case/service-mesh",
