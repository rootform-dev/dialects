        "google": "https://cloud.google.com/vpc/docs/vpc-peering"
      }
    },
    {
      "candidate": "identity-provider",
      "disposition": "defer-identity-wave",
      "reason": "Consul auth and JWT providers need Okta/Auth0 evidence before a stable core identity boundary",
      "sources": {
        "consul": "https://developer.hashicorp.com/consul/docs/secure/acl/auth-methods",
        "okta": "https://developer.okta.com/docs/concepts/identity-providers/",
        "auth0": "https://auth0.com/docs/authenticate/identity-providers"
      }
    },
