  "rejected_candidates": [
    {
      "candidate": "container-registry",
      "disposition": "keep-provider-specific",
      "reason": "Azure owns a registry resource, Google owns repositories, and AWS registry ownership is partly implicit."
    },
    {
      "candidate": "content-delivery-service",
      "disposition": "keep-provider-specific",
      "reason": "Azure and AWS expose durable distribution/profile resources while Google Cloud CDN is enabled through load-balancing backends."
    },
    {
      "candidate": "event-stream",
      "disposition": "keep-provider-specific",
      "reason": "Event Hubs, Pub/Sub, Kinesis, and managed Kafka differ in stream, topic, consumer, and retention identity."
    },
    {
      "candidate": "managed-container-service",
      "disposition": "keep-provider-specific",
      "reason": "Azure Container Apps, Cloud Run, and AWS container services retain materially different workload and deployment boundaries."
    },
    {
      "candidate": "network-security-group",
      "disposition": "keep-provider-specific",
      "reason": "Existing three-cloud evidence rejects one firewall/security boundary across Azure NSGs, AWS security groups/NACLs, and Google Cloud firewall policy."
    }
  ],
  "limitations": [
    "Core identity does not import Azure topology, hierarchy, lifecycle, or configuration.",
    "AWS implementation remains future work; official AWS contracts are comparison evidence only.",
