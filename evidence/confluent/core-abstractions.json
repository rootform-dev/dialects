      "candidate": "environment",
      "disposition": "keep-confluent-specific",
      "comparison": "Confluent environments isolate Confluent resources and Stream Governance; AWS accounts, Azure subscriptions, and Google Cloud projects own broader cloud tenancy and billing boundaries.",
      "sources": {
        "confluent": "https://docs.confluent.io/cloud/current/access-management/hierarchy/cloud-environments.html",
        "google": "https://cloud.google.com/resource-manager/docs/cloud-platform-resource-hierarchy",
        "aws": "https://docs.aws.amazon.com/accounts/latest/reference/manage-acct-creating.html",
        "azure": "https://learn.microsoft.com/en-us/azure/cloud-adoption-framework/ready/azure-setup-guide/organize-resources"
      }
    },
    {
      "candidate": "kafka-cluster",
      "disposition": "keep-confluent-specific",
      "comparison": "Managed Kafka and Kafka-compatible services overlap, but cluster tiers, ownership, networking, capacity, and protocol contracts differ across Confluent Cloud, Amazon MSK, Azure Event Hubs, and Google Managed Service for Apache Kafka.",
      "sources": {
        "confluent": "https://docs.confluent.io/cloud/current/clusters/index.html",
        "google": "https://cloud.google.com/managed-service-for-apache-kafka/docs/overview",
        "aws": "https://docs.aws.amazon.com/msk/latest/developerguide/what-is-msk.html",
        "azure": "https://learn.microsoft.com/en-us/azure/event-hubs/event-hubs-about"
      }
    },
    {
      "candidate": "cluster-link",
      "disposition": "keep-confluent-specific",
      "comparison": "Cluster Linking preserves Confluent Kafka mirror-topic offsets and partitions; MSK Replicator, Event Hubs geo-replication, and MirrorMaker connectors expose different replication identity and failover semantics.",
      "sources": {
        "confluent": "https://docs.confluent.io/cloud/current/multi-cloud/cluster-linking/index.html",
        "google": "https://cloud.google.com/managed-service-for-apache-kafka/docs/connect-cluster/create-mirrormaker-connector",
        "aws": "https://docs.aws.amazon.com/msk/latest/developerguide/msk-replicator.html",
        "azure": "https://learn.microsoft.com/en-us/azure/event-hubs/geo-replication"
      }
    },
    {
      "candidate": "connector",
      "disposition": "keep-confluent-specific",
      "comparison": "Confluent managed connectors run against Kafka clusters; MSK Connect, Azure Data Factory connectors, and Google Integration Connectors differ in runtime, direction, ownership, and configuration contracts.",
      "sources": {
        "confluent": "https://docs.confluent.io/cloud/current/connectors/overview.html",
        "google": "https://cloud.google.com/integration-connectors/docs/overview",
        "aws": "https://docs.aws.amazon.com/msk/latest/developerguide/msk-connect.html",
        "azure": "https://learn.microsoft.com/en-us/azure/data-factory/connector-overview"
      }
    },
    {
      "candidate": "flink-compute-pool",
      "disposition": "keep-confluent-specific",
      "comparison": "Confluent Flink compute pools provide regional CFU capacity for statements; AWS Managed Service for Apache Flink, Azure Stream Analytics, and Google Cloud Dataflow expose different job and capacity ownership.",
      "sources": {
        "confluent": "https://docs.confluent.io/cloud/current/flink/concepts/compute-pools.html",
        "google": "https://cloud.google.com/dataflow/docs/concepts/overview",
        "aws": "https://docs.aws.amazon.com/managed-flink/latest/java/what-is.html",
        "azure": "https://learn.microsoft.com/en-us/azure/stream-analytics/stream-analytics-introduction"
      }
    },
    {
      "candidate": "schema-registry",
      "disposition": "keep-confluent-specific",
      "comparison": "Confluent Schema Registry is one environment-scoped registry with subjects and compatibility modes; AWS Glue Schema Registry, Azure Schema Registry, and Pub/Sub schemas use different ownership and compatibility models.",
      "sources": {
        "confluent": "https://docs.confluent.io/cloud/current/get-started/schema-registry.html",
        "google": "https://cloud.google.com/pubsub/docs/schemas",
        "aws": "https://docs.aws.amazon.com/glue/latest/dg/schema-registry.html",
        "azure": "https://learn.microsoft.com/en-us/azure/event-hubs/schema-registry-overview"
      }
