      "sources": {
        "google": "https://cloud.google.com/cdn/docs/overview",
        "aws": "https://docs.aws.amazon.com/AmazonCloudFront/latest/DeveloperGuide/Introduction.html",
        "azure": "https://learn.microsoft.com/en-us/azure/frontdoor/front-door-overview"
      },
      "disposition": "keep-provider-specific"
