{
  "format_version": "1",
  "scenarios": [
    {
      "id": "hcp-minimal",
      "fixture": "testdata/architecture/hcp-v0/minimal",
      "limitations": [
        "synthetic Terraform proves project, HVN, Vault Dedicated, and Private Link architecture without contacting HCP"
      ],
      "minimum": {
        "entities": 2,
        "scopes": 2,
        "relations": 1,
        "contexts": 5
      },
      "maximum_facts": {
        "relations": 1,
        "contexts": 5,
        "contributions": 0
      },
      "required_rules": ["hcp/hvn", "hcp/private-link", "hcp/project", "hcp/vault-cluster"],
      "required_facts": [
        {
          "collection": "contexts",
          "from": "scope:hcp_hvn.security",
          "to": "scope:hcp_project.platform",
          "dimension": "core/ownership",
          "rule": "hcp/hvn"
        },
        {
          "collection": "contexts",
          "from": "entity:hcp_vault_cluster.security",
          "to": "scope:hcp_hvn.security",
          "dimension": "core/network",
          "rule": "hcp/vault-cluster"
        },
        {
          "collection": "relations",
          "from": "entity:hcp_private_link.vault",
          "to": "entity:hcp_vault_cluster.security",
          "type": "exposes-vault-cluster",
          "rule": "hcp/private-link"
        }
      ],
      "expected_html_labels": [
        "HashiCorp Virtual Network (HVN)",
        "HCP Vault Dedicated cluster",
        "HCP Vault Private Link"
      ]
    },
