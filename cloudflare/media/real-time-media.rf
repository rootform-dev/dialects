concept "calls-sfu-application" {
  kind        = entity
  description = "A Cloudflare Calls selective forwarding unit application."
}

concept "calls-turn-application" {
  kind        = entity
  description = "A Cloudflare Calls TURN application providing relay credentials and endpoints."
}

concept "moq-relay" {
  kind        = entity
  description = "A Cloudflare Media over QUIC relay."
}

concept "stream-live-input" {
  kind        = entity
  description = "A Cloudflare Stream live video input."
}

concept "stream-configuration" {
  kind        = detail
  description = "Webhook or delivery configuration supporting Cloudflare Stream."
}

rule "calls-sfu-app" {
  match {
    type = "cloudflare_calls_sfu_app"
  }

  as = concept.calls-sfu-application
}

rule "calls-turn-app" {
  match {
    type = "cloudflare_calls_turn_app"
  }

  as = concept.calls-turn-application
}

rule "moq-relay" {
  match {
    type = "cloudflare_moq_relay"
  }

  as = concept.moq-relay
}

rule "stream-live-input" {
  match {
    type = "cloudflare_stream_live_input"
  }

  as = concept.stream-live-input
}

rule "stream-webhook" {
  match {
    type = "cloudflare_stream_webhook"
  }

  as = concept.stream-configuration
}
