rule "cloud-run-function" {
  match {
    kind = "resource"
    type = "google_cloudfunctions_function"
  }

  as = concept.core.serverless-function
}

rule "cloud-run-function-v2" {
  match {
    kind = "resource"
    type = "google_cloudfunctions2_function"
  }

  as = concept.core.serverless-function
}
