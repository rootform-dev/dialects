# Maintained directly from pinned provider evidence.
rule "web-pubsub" {
  match {
    kind = "resource"
    type = "azurerm_web_pubsub"
  }

  as = concept.realtime-communication-service

  context {
    as  = context.core.ownership
    to  = concept.resource-group
    via = source.resource_group_name
  }
}
